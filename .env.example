# Variables d'environnement — NOMS SEULEMENT. Ne jamais committer de valeurs réelles.
CLOVER_APP_ID=
CLOVER_CLIENT_ID=
CLOVER_CLIENT_SECRET=
CLOVER_WEBHOOK_AUTH=
CLOVER_API_BASE=https://api.clover.com
APP_BASE_URL=
DATABASE_URL=

# --- Added with the working app (2026-10-28) — names only ---
# 32 bytes, hex (64 characters) or base64: seals each merchant's Clover tokens in the database. openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=
# 32+ characters: signs the merchant's session cookie. openssl rand -hex 32
SESSION_SECRET=
# 24+ characters: operator endpoints (/api/cron, webhook verification code). openssl rand -hex 24
ADMIN_TOKEN=
# Optional: authorize page (derived from CLOVER_API_BASE: sandbox → https://sandbox.dev.clover.com)
CLOVER_WEB_URL=
# Our own restaurants (Clover merchant IDs, comma-separated): every feature, never billed
OWN_MERCHANTS=
# Merchants the app may read but never write to (default: the dormant On2GO.ca account)
NEVER_WRITE_MERCHANTS=RNVTBYMCKXEJ1
# TAKATAK Suite link (optional): Food Hub address and the same secret as FOODHUB_SUITE_<APP>_SECRET in Food Hub
FOODHUB_URL=
FOODHUB_SUITE_SECRET=
